{%- comment -%}
  Pflicht-Einwilligungen für Anfrageformulare.
  Usage: {% render 'kfl-consents', type: 'deal' %}  (deal | sell | support | partner)
  Rechtsgrundlage der Weitergabe an Partner: Art. 6 Abs. 1 lit. b DSGVO (Vertragsanbahnung) – daher
  Kenntnisnahme statt Einwilligung; die Werbe-/Kontakteinwilligung ist separat.
  Optional (deal/sell): Einwilligung in Zufriedenheitsumfragen per E-Mail (§ 7 Abs. 2 UWG), jederzeit per Link widerrufbar.
{%- endcomment -%}
{%- capture legal_v -%}{% render 'kfl-config', key: 'legal' %}{%- endcapture -%}{%- assign legal_v = legal_v | strip -%}
{%- liquid
  assign agb = shop.terms_of_service.url | default: '/policies/terms-of-service'
  assign agb_label = 'AGB'
  if type == 'partner'
    assign agb = '/pages/agb-partner'
    assign agb_label = 'AGB für Geschäftspartner'
  endif
  assign privacy = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign refund = shop.refund_policy.url | default: '/policies/refund-policy'
-%}
<div class="k-consents" role="group" aria-label="Einwilligungen und rechtliche Hinweise">
  <label class="k-consent k-field">
    <input type="checkbox" name="contact[AGB akzeptiert]" value="Ja (Version {{ legal_v }})" required>
    <span>Ich akzeptiere die <a href="{{ agb }}" target="_blank" rel="noopener">{{ agb_label }}</a> der KFL GbR.{% if type != 'support' and type != 'partner' %} Die <a href="{{ refund }}" target="_blank" rel="noopener">Widerrufsbelehrung</a> habe ich zur Kenntnis genommen.{% endif %} <span class="k-error-text" hidden>Bitte bestätigen.</span></span>
  </label>
  <label class="k-consent k-field">
    <input type="checkbox" name="contact[Datenschutz akzeptiert]" value="Ja (Version {{ legal_v }})" required>
    <span>Ich habe die <a href="{{ privacy }}" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung meiner Anfrage einverstanden. <span class="k-error-text" hidden>Bitte bestätigen.</span></span>
  </label>
  {%- if type == 'deal' or type == 'sell' -%}
    <label class="k-consent k-field">
      <input type="checkbox" name="contact[Weitergabe an Partner und Kontaktaufnahme]" value="Ja" required>
      <span>Mir ist bekannt, dass KFL meine Angaben an ausgewählte Partner weitergibt, um {% if type == 'deal' %}Angebote für mich{% else %}ein Ankaufangebot für mein Fahrzeug{% endif %} einzuholen, und dass diese mich dazu kontaktieren. <span class="k-error-text" hidden>Bitte bestätigen.</span></span>
    </label>
    <details class="k-consent-more" style="margin:-.6rem 0 0 3.4rem;font-size:1.3rem;color:var(--k-muted,#6b6b70)">
      <summary style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;width:max-content">Mehr erfahren</summary>
      <p style="margin:.8rem 0 0;line-height:1.5">
        {%- if type == 'deal' -%}
          KFL gibt deine Angaben nur im erforderlichen Umfang an ausgewählte Partner weiter: Autohäuser, Banken, Leasinggesellschaften und, wenn du ein Servicepaket wählst, Service- und Versicherungspartner. KFL und diese Partner kontaktieren dich dazu per E-Mail oder Telefon. Gibst du dein jetziges Auto in Zahlung, gehen dessen Fahrzeugdaten zusätzlich an ausgewählte Ankaufpartner. Ohne diese Weitergabe kann KFL den Service nicht erbringen (Art. 6 Abs. 1 lit. b DSGVO). Details in der <a href="{{ privacy }}" target="_blank" rel="noopener">Datenschutzerklärung</a>.
        {%- else -%}
          KFL gibt deine Fahrzeug- und Kontaktdaten nur im erforderlichen Umfang an ausgewählte Ankaufpartner weiter. KFL und diese Partner kontaktieren dich dazu per E-Mail oder Telefon. Ohne diese Weitergabe kann KFL den Service nicht erbringen (Art. 6 Abs. 1 lit. b DSGVO). Details in der <a href="{{ privacy }}" target="_blank" rel="noopener">Datenschutzerklärung</a>.
        {%- endif -%}
      </p>
    </details>
    <label class="k-consent k-field">
      <input type="checkbox" name="contact[Einwilligung Feedback und Erinnerungen]" value="Ja (Version {{ legal_v }})">
      <span><span class="k-muted">Optional:</span> KFL darf mich per E-Mail nach meiner Zufriedenheit fragen. Jederzeit per Link in der E-Mail widerrufbar.</span>
    </label>
  {%- endif -%}
  <input type="hidden" name="contact[Einwilligung Zeitpunkt]" value="">
</div>
